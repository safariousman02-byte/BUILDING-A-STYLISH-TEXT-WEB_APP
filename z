.status-icon {
  color: var(--primary);
}

.status-icon .material-symbols-outlined {
  font-size: 22px;
}

.vault-status strong {
  font-size: 12px;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4px;
  font-weight: 600;
}

.vault-status p {
  font-size: 10px;
  color: var(--text-secondary);
  line-height: 1.5;
  font-weight: 500;
}

/* BOTTOM NAV */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: var(--surface-raised);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  padding: 12px;
  z-index: 100;
  max-width: 430px;
  margin: 0 auto;
  box-shadow: 0 -8px 20px rgba(0, 0, 0, 0.5);
}

.nav-item {
  text-align: center;
  padding: 10px 8px;
  border-radius: var(--r-md);
  cursor: pointer;
  transition: all 0.15s ease;
  text-decoration: none;
  color: inherit;
  display: block;
}

.nav-item span .material-symbols-outlined {
  font-size: 22px;
  display: block;
  margin-bottom: 4px;
  color: var(--text-tertiary);
}

.nav-item p {
  font-size: 10px;
  color: var(--text-tertiary);
  font-weight: 500;
}

.nav-item.active {
  box-shadow: var(--shadow-inset);
}

.nav-item.active span .material-symbols-outlined,
.nav-item.active p {
  color: var(--primary);
  font-weight: 600;
}
